# ---------------------------------------------------------------------------
# Banco de dados (Supabase - Postgres)
#
# LOCAL: pode usar a conexao direta (Supabase > Connect > Direct connection).
# PRODUCAO (Vercel): use o Transaction Pooler (Supavisor). A conexao direta
# "db.<ref>.supabase.co:5432" so resolve em IPv6 e as funcoes da Vercel sao
# IPv4 -> o Prisma nunca conecta e o login falha como "senha invalida".
#   postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<senha>@db.xadpkdshxqmnmybiefyp.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Primeiro Administrador criado por "npm run seed"
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Google Drive (opcional) - botao "Atualizar do Drive" na Administracao.
#
# Conta de servico do Google Cloud, com a API do Drive habilitada. A pasta da
# loja precisa ser compartilhada (leitor) com o e-mail da conta de servico --
# assim ela continua privada, sem link publico.
#
# O escopo pedido e somente leitura: o sistema nao altera nada no Drive.
#
# Cole o JSON inteiro OU o mesmo JSON em base64 (mais seguro para variavel de
# ambiente, porque a chave privada tem quebras de linha):
#   base64 -i chave.json | pbcopy
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ID da pasta: e o trecho depois de /folders/ na URL do Drive
GOOGLE_DRIVE_FOLDER_ID=""
