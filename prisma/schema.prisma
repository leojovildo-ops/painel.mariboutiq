// Painel Mariboutique 360 - modulo de VENDAS
// Fonte dos dados: planilhas .xlsx mensais preenchidas na loja e importadas
// manualmente por um Administrador (ver src/lib/xlsx/parseMonthWorkbook.ts).
// Fase 1: metas da loja, ranking de vendas e ranking de nivel. Sem financeiro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISORA
  VENDEDORA
}

/// "Mari Boutique" (aba consolidada) vs cada aba de vendedora.
enum StatsScope {
  STORE
  SELLER
}

/// Os nomes vem das proprias planilhas (colunas I/J/K, linhas 23-25).
enum GoalLevel {
  PRATA
  OURO
  DIAMANTE
}

enum ImportStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

/// Uma planilha de vendas (uma por mes) ou a planilha de despesas (o ano todo).
enum ImportKind {
  SALES
  EXPENSES
}

/// Onde o dinheiro fica: conta de banco, maquininha ou dinheiro em especie.
enum AccountKind {
  BANCO
  MAQUININHA
  ESPECIE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VENDEDORA)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Só para o perfil VENDEDORA: liga o login à aba da planilha.
  sellerId String? @unique
  seller   Seller? @relation(fields: [sellerId], references: [id])

  /// Acesso ao módulo financeiro. É um direito por pessoa, e não por perfil:
  /// hoje só o diretor de operações e a CEO têm, e um Administrador novo
  /// NÃO passa a ver os números da empresa só por ser Administrador.
  canViewFinance Boolean @default(false)

  imports     ImportBatch[]
  editedStats MonthlyStats[] @relation("StatsEditedBy")

  @@map("users")
}

/// Uma vendedora = uma aba da planilha. Criada automaticamente na importação
/// quando o nome da aba ainda não existe (a equipe muda de mês para mês).
model Seller {
  id        String @id @default(cuid())
  /// Nome da aba, normalizado em maiúsculas (ex.: "MAYARA").
  sheetName String @unique
  /// Nome de exibição, editável pelo Administrador (ex.: "Mayara Silva").
  name      String

  /// Outras grafias pelas quais ela aparece na pesquisa de satisfação
  /// ("Stefanny", "Ster"...). Editável na tela de Administração.
  aliases   String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?
  stats MonthlyStats[]

  @@map("sellers")
}

/// Um mês importado (ex.: 2026/07). Criado na primeira importação do mês.
model Period {
  id    String @id @default(cuid())
  year  Int
  month Int

  stats    MonthlyStats[]
  imports  ImportBatch[]
  expenses Expense[]
  finance  FinanceMonth?
  balances AccountBalance[]
  caixa    CashFlowInsight?
  especie  CashInflow?

  @@unique([year, month])
  @@map("periods")
}

model ImportBatch {
  id            String       @id @default(cuid())
  /// Planilha de vendas (uma por mes) ou a planilha de despesas do ano.
  kind          ImportKind   @default(SALES)
  fileName      String
  status        ImportStatus @default(PENDING)
  /// Prévia extraída do arquivo, mostrada para conferência antes de salvar.
  preview       Json
  sheetsFound   Int          @default(0)
  sheetsIgnored Json?
  warnings      Json?
  periodId      String?
  period        Period?      @relation(fields: [periodId], references: [id])
  importedById  String
  importedBy    User         @relation(fields: [importedById], references: [id])
  createdAt     DateTime     @default(now())
  confirmedAt   DateTime?

  @@index([status])
  @@map("import_batches")
}

/// Números consolidados do mês, por vendedora (scope SELLER) ou da loja
/// inteira (scope STORE, aba "Mari Boutique"). Campos nulos = "sem dado"
/// na planilha de origem (planilhas antigas não têm SALÃO/ONLINE).
model MonthlyStats {
  id       String     @id @default(cuid())
  scope    StatsScope
  periodId String
  period   Period     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sellerId String?
  seller   Seller?    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  revenue    Decimal  @default(0) @db.Decimal(12, 2)
  salesCount Int      @default(0)
  pieces     Int      @default(0)
  /// Peças por atendimento e ticket médio. Nulos quando não há vendas
  /// suficientes para calcular (planilha traz #DIV/0!).
  pa         Decimal? @db.Decimal(10, 2)
  tkm        Decimal? @db.Decimal(12, 2)
  salao      Decimal? @db.Decimal(12, 2)
  online     Decimal? @db.Decimal(12, 2)

  workingDays Int?
  workedDays  Int?
  /// Linha 25: projeção de fechamento do mês.
  projection  Decimal? @db.Decimal(12, 2)

  /// Nota de satisfação do atendimento no mês, de 0 a 10 (média das respostas
  /// da pesquisa, não o índice NPS de promotores menos detratores).
  /// Na loja, fica nula quando deve ser calculada a partir das vendedoras.
  npsScore Decimal? @db.Decimal(4, 2)

  /// Quantas respostas da pesquisa geraram essa nota.
  npsResponses Int?

  /// Nível definido à mão para o mês, quando o cálculo pelo faturamento não
  /// reflete o combinado (ex.: mês que soma o período de experiência).
  /// Fica num campo próprio: mexer na meta ou no faturamento para forçar o
  /// nível apagaria o número real e ninguém entenderia depois.
  levelOverride GoalLevel?

  /// Observação do mês, mostrada nas telas junto do nome da vendedora.
  /// Preenchida sozinha quando a planilha traz mais de uma aba da mesma
  /// pessoa (ex.: período de experiência + carteira assinada), e editável
  /// pelo Administrador.
  note String?

  /// Marcado quando um Administrador corrigiu um valor à mão.
  editedAt   DateTime?
  editedById String?
  editedBy   User?     @relation("StatsEditedBy", fields: [editedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals Goal[]
  days  DailyEntry[]

  @@unique([periodId, sellerId, scope])
  @@index([periodId])
  @@map("monthly_stats")
}

/// Metas Prata/Ouro/Diamante do mês (colunas I/J/K, linhas 23-25).
/// Podem ser diferentes por vendedora e por mês.
model Goal {
  id      String       @id @default(cuid())
  statsId String
  stats   MonthlyStats @relation(fields: [statsId], references: [id], onDelete: Cascade)
  level   GoalLevel
  target  Decimal      @db.Decimal(12, 2)

  @@unique([statsId, level])
  @@map("goals")
}

/// Linhas 8..18 da aba: um registro por dia do mês.
model DailyEntry {
  id      String       @id @default(cuid())
  statsId String
  stats   MonthlyStats @relation(fields: [statsId], references: [id], onDelete: Cascade)
  day     Int
  revenue Decimal?     @db.Decimal(12, 2)
  sales   Int?
  salao   Decimal?     @db.Decimal(12, 2)
  online  Decimal?     @db.Decimal(12, 2)
  pieces  Int?

  @@unique([statsId, day])
  @@map("daily_entries")
}

/// Um lançamento de despesa, como está nas abas mensais (JAN..DEZ) da planilha
/// de despesas: uma linha por conta. Visível só para quem tem `canViewFinance`.
model Expense {
  id          String    @id @default(cuid())
  periodId    String
  period      Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  /// GRUPO: Impostos, Custos Fixos, Custos Variáveis, Despesas Funcionário,
  /// Despesas Pessoal dos Sócios, Fornecedor. Vem da planilha, não é fixo aqui.
  group       String
  description String
  docType     String?
  dueDate     DateTime?
  amount      Decimal   @db.Decimal(12, 2)
  paidAt      DateTime?
  balance     Decimal?  @db.Decimal(12, 2)
  /// Linha de origem na aba, para conferir contra a planilha quando divergir.
  sourceRow   Int
  createdAt   DateTime  @default(now())

  @@index([periodId])
  @@index([periodId, group])
  @@map("expenses")
}

/// Numeros do mes que vem da planilha de DESPESAS (aba "RESUMO DESPESAS ANO").
/// Fica separado de MonthlyStats de proposito: aquele e a verdade das vendas,
/// vinda das planilhas mensais de vendas, e nao pode ser sobrescrito pela
/// planilha financeira. O painel usa o faturamento das vendas quando o mes ja
/// foi importado, e cai para este aqui quando ainda nao foi.
model FinanceMonth {
  id           String   @id @default(cuid())
  periodId     String   @unique
  period       Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grossRevenue Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("finance_months")
}

/// Conta em que o dinheiro da loja fica (Bradesco, Stone, espécie...).
model Account {
  id        String      @id @default(cuid())
  name      String      @unique
  kind      AccountKind @default(BANCO)
  active    Boolean     @default(true)
  /// Ordem de exibição na tabela de saldos.
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  balances AccountBalance[]

  @@map("accounts")
}

/// Saldo de abertura e de fechamento de uma conta em um mês.
///
/// Preenchido à mão a partir dos extratos, então os dois valores são
/// opcionais: extrato que não foi encontrado fica como "sem dado", e nunca
/// como zero — zero é um saldo de verdade e significa outra coisa.
model AccountBalance {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodId  String
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  opening   Decimal? @db.Decimal(12, 2)
  closing   Decimal? @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, periodId])
  @@index([periodId])
  @@map("account_balances")
}

/// Foto do estoque vinda do SISloja, um registro por produto.
model StockItem {
  id          String   @id @default(cuid())
  barcode     String   @unique
  code        String?
  description String
  size        String?
  color       String?
  quantity    Int      @default(0)
  price       Decimal? @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  supplier    String?
  category    String?
  status      String?
  brand       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("stock_items")
}

/// Venda item a item, para calcular giro, margem e o que esta parado.
model StockSale {
  id          String   @id @default(cuid())
  date        DateTime
  orderNo     String?
  barcode     String
  description String
  quantity    Int      @default(1)
  cost        Decimal? @db.Decimal(12, 2)
  unitPrice   Decimal? @db.Decimal(12, 2)
  total       Decimal? @db.Decimal(12, 2)
  sellerName  String?
  createdAt   DateTime @default(now())

  @@index([barcode])
  @@index([date])
  @@map("stock_sales")
}

/// De quando e a foto do estoque e que periodo as vendas cobrem.
model StockSnapshot {
  id        String    @id @default(cuid())
  fileName  String
  itemCount Int       @default(0)
  saleCount Int       @default(0)
  salesFrom DateTime?
  salesTo   DateTime?
  createdAt DateTime  @default(now())

  @@map("stock_snapshots")
}

/// O que o robo diario ja trouxe de cada arquivo do Drive.
///
/// Guarda o modifiedTime da ultima importacao que rodou: enquanto o arquivo
/// nao for mexido de novo no Drive, ele e pulado. Tentativas que falharam
/// tambem sao gravadas, senao um arquivo quebrado seria rebaixado e
/// reprocessado todo dia — e, quando alguem corrige a planilha, o proprio
/// modifiedTime muda e ela volta para a fila sozinha.
model DriveSync {
  fileId       String   @id
  fileName     String
  tipo         String
  modifiedTime DateTime
  syncedAt     DateTime @updatedAt
  ok           Boolean  @default(true)
  /// Resumo do que entrou, ou a mensagem do erro.
  detail       String?

  @@map("drive_syncs")
}

/// Leitura de caixa do mes, feita a mao fora do sistema e guardada aqui.
///
/// Diferente das outras telas, esta NAO recalcula nada: o texto e o status
/// vieram de uma analise que cruzou os extratos com o resultado do mes, e
/// refazer a conta a cada acesso perderia justamente o que ela tem de melhor,
/// que e a explicacao do porque (parcela de emprestimo, retirada de socio).
model CashFlowInsight {
  id       String @id @default(cuid())
  periodId String @unique
  period   Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  revenue  Decimal? @db.Decimal(12, 2)
  expenses Decimal? @db.Decimal(12, 2)
  /// Resultado do mes em reais (receita menos despesa), nao um percentual.
  margin   Decimal? @db.Decimal(12, 2)

  cashDeltaBradesco Decimal? @db.Decimal(12, 2)
  cashDeltaStone    Decimal? @db.Decimal(12, 2)
  cashDeltaInfinity Decimal? @db.Decimal(12, 2)
  cashDeltaTotal    Decimal? @db.Decimal(12, 2)

  /// POSITIVO | ATENCAO | NEGATIVO
  status String
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_flow_insights")
}

/// Quanto entrou em dinheiro (especie) na loja no mes, vindo do SISloja.
/// E fluxo de entrada, e nao saldo: o saldo do cofre fica em AccountBalance.
model CashInflow {
  id        String   @id @default(cuid())
  periodId  String   @unique
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_inflows")
}

/// Parametros da loja que nao vem de planilha (ex.: quanto uma viagem de
/// compras costuma levar em especie). Chave e valor para nao precisar de uma
/// migration a cada numero novo.
model StoreSetting {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
